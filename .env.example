# ============================================================================
# SWAMI VIVEKANAND SIKSHAN SANSTHAN — SCHOOL FEE MANAGEMENT SYSTEM (SFMS)
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with actual secrets.
# NEVER commit a real .env file or real credentials to version control.
# ============================================================================

# --- Application Environment (development | test | production) ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_TIMEZONE=Asia/Kolkata

# --- PostgreSQL Database Connection (Neon Hosted PostgreSQL or Local PostgreSQL) ---
# For Neon Hosted PostgreSQL:
#   - DATABASE_URL must use the Neon pooled connection string (-pooler) with ?sslmode=require&pgbouncer=true&connect_timeout=15
#   - DIRECT_URL must use the Neon direct connection string (non-pooler) with ?sslmode=require for Prisma migrations (prisma migrate deploy)
# For Local Office PostgreSQL:
#   - Set both DATABASE_URL and DIRECT_URL to postgresql://USER:PASSWORD@127.0.0.1:5432/svss_fee_db?schema=public
DATABASE_URL="postgresql://NEON_DB_USER:REPLACE_WITH_NEON_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/svss_fee_db?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://NEON_DB_USER:REPLACE_WITH_NEON_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/svss_fee_db?sslmode=require&connect_timeout=15"

# --- Optional Separate Test Database URL (Used ONLY by automated test suites; never point at production) ---
TEST_DATABASE_URL="postgresql://svss_test:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5432/svss_fee_test_db?schema=public"

# --- Session & CSRF Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_64_BYTE_RANDOM_HEX_SESSION_SECRET"
CSRF_SECRET="REPLACE_WITH_64_BYTE_RANDOM_HEX_CSRF_SECRET"
SESSION_TTL_MINUTES=480
COOKIE_SECURE=true

# --- CORS & Frontend Origin Restrictions ---
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Login Rate Limiting & Lockout Policy ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Receipt & Accounting Policy Defaults ---
DEFAULT_RECEIPT_PREFIX="SVSS"
AUTO_ALLOCATE_OLDEST_FIRST=true

# --- Encrypted Backup & Independent Local Storage Settings ---
BACKUP_PRIMARY_DIR="D:\SVSS_Backups\Daily"
BACKUP_EXTERNAL_USB_DIR="E:\SVSS_External_Backups"
BACKUP_RETENTION_DAYS=90
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY_HEX="REPLACE_WITH_64_HEX_CHARS_FOR_AES_256_GCM_BACKUP_ENCRYPTION"
PG_DUMP_PATH="pg_dump"
PG_RESTORE_PATH="psql"
