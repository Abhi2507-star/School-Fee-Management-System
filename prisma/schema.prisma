// ============================================================================
// SWAMI VIVEKANAND SIKSHAN SANSTHAN (स्वामी विवेकानन्द शिक्षण संस्थान)
// Ultra-Simple School Fee Management Database Schema
// Upgraded with Class Promotion, Status (Active/Left), Previous Class Due,
// Joined Month, and Multi-Year Academic History
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                   Int                   @id @default(autoincrement())
  roll_no              Int
  student_name         String
  father_name          String
  village              String
  mobile               String                @default("")
  class_name           String
  academic_year        String                @default("2026-27")
  status               String                @default("ACTIVE") // ACTIVE, LEFT
  previous_class_due   Float                 @default(0)
  joined_month         String                @default("APRIL") // APRIL, MAY, JUNE, etc.
  admission_fee_status String                @default("PENDING") // PAID, FREE, PENDING
  admission_fee_amount Float                 @default(0)
  admission_fee_date   String?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  payments             FeePayment[]
  history              StudentClassHistory[]

  @@map("students")
  @@unique([class_name, roll_no, academic_year])
}

model FeeStructure {
  class_name            String   @id
  monthly_fee           Float    @default(250)
  exam_fee              Float    @default(250)
  default_admission_fee Float    @default(500)
  updated_at            DateTime @updatedAt

  @@map("fee_structures")
}

model FeePayment {
  id            Int      @id @default(autoincrement())
  student_id    Int
  fee_head      String   // ADMISSION, APRIL, MAY..., OLD_BALANCE
  amount_paid   Float
  payment_date  String
  receipt_no    String
  class_name    String   @default("Class 6")
  academic_year String   @default("2026-27")
  collected_by  String   @default("Fee Collector")
  created_at    DateTime @default(now())

  student       Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("fee_payments")
  @@unique([student_id, fee_head, academic_year])
}

model StudentClassHistory {
  id                   Int      @id @default(autoincrement())
  student_id           Int
  academic_year        String
  class_name           String
  roll_no              Int
  admission_fee_status String   @default("PAID")
  admission_fee_amount Float    @default(0)
  pending_due_amount   Float    @default(0)
  created_at           DateTime @default(now())

  student              Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("student_class_history")
  @@unique([student_id, academic_year, class_name])
}

model ReceiptCounter {
  id         Int    @id @default(autoincrement())
  year       String @unique
  last_count Int    @default(0)

  @@map("receipt_counters")
}
