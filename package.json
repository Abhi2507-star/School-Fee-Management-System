{
  "name": "swami-vivekanand-fee-management",
  "version": "1.0.0",
  "private": true,
  "description": "Production School Fee Management System (SFMS) for Swami Vivekanand Sikshan Sansthan",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@svss/web",
    "dev": "concurrently \"npm run dev --workspace=@svss/api\" \"npm run dev --workspace=@svss/web\"",
    "build": "npm run build --workspace=@svss/api && npm run build --workspace=@svss/web",
    "build:web": "npm run build --workspace=@svss/web",
    "build:api": "npm run build --workspace=@svss/api",
    "start": "npm run start --workspace=@svss/api",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/run-all-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "concurrently": "9.1.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "type": "module"
}
